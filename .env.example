# Copie ce fichier en .env (il n'est jamais commité) et remplis les valeurs.

# Position « maison » (bouton MAISON dans les réglages). La position courante se change depuis l'écran. 3 décimales suffisent (~100 m de précision).
HOME_LAT=45.764
HOME_LON=4.836

# Fréquence d'interrogation des avions (adsb.fi), en secondes (minimum 5).
# C'est aussi la durée d'un tour de balayage du radar.
AIRCRAFT_POLL_S=6

# Département de la maison pour les vigilances météo (ailleurs, il est trouvé automatiquement).
WEATHER_AREA=Rhône

# Bambu Lab A1, lecture seule en LAN.
# IP : écran de l'imprimante > Réglages > WLAN (pense à la fixer dans ta box).
# Numéro de série et code d'accès : écran de l'imprimante > Réglages > Général / WLAN.
BAMBU_HOST=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=

# Prix (filament au kilo, kWh) : réglables dans data/settings.json (filamentPriceKg, kwhPrice, printerWatts).

# Mettre à 1 pour simuler une imprimante (tests sans A1).
MOCK_PRINTER=0
